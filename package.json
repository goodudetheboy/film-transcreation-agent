{
  "name": "film-transcreation-agent",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "tests/integration"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:integration": "npm run test -w tests/integration",
    "test": "npm run test:frontend && npm run test:backend && npm run test:integration"
  }
