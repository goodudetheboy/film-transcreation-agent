{
  "name": "film-transcreation-agent",
  "private": true,
  "workspaces": [
    "frontend",
    "proxy",
    "tests/integration"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:proxy": "npm run dev -w proxy",
