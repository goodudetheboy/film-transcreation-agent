PORT=8787
SHARED_PASSCODE=change-me-for-local-dev
GOOGLE_CLOUD_PROJECT=silent-scholar-505618-u6
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Leave empty to use the Marketplace "Parallel Web Search for Grounding" subscription
# (no key needed). Only set this for a bring-your-own-key setup with Parallel directly.
PARALLEL_API_KEY=
VIDEO_CLIPS_BUCKET=silent-scholar-505618-u6-clips
MAX_VIDEO_UPLOAD_BYTES=500000000
FILMS_DATA_FILE=.data/films.json
FIRESTORE_LOCATION=us-central1
SUBTITLE_UPLOAD_PREFIX=subtitles/
MAX_SUBTITLE_UPLOAD_BYTES=5000000
# Multiplies every mock's simulated wait time (see services/testDelay.ts). 1 = realistic
# demo pacing; set lower (e.g. 0.1) to speed up local iteration.
MOCK_DELAY_SCALE=1
# Local directory that mock-mode video uploads are written to and served back
# from (see routes/films.ts upload-video mock branch). Same .data/ convention
# as FILMS_DATA_FILE above; safe to leave at the default.
MOCK_UPLOADS_DIR=.data/mock-uploads
